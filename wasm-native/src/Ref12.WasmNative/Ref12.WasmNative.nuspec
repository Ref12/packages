<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Ref12.WasmNative</id>
    <version>$version$</version>
    <authors>ref12labs</authors>
    <description>MSBuild project SDK: relink / AOT for browser-wasm (Microsoft.NET.Sdk.WebAssembly) without 'dotnet workload install'. Fetches the workload's packs from NuGet at evaluation time.</description>
    <license type="expression">MIT</license>
    <packageTypes><packageType name="MSBuildSdk" /></packageTypes>
  </metadata>
  <files>
    <file src="Sdk\*" target="Sdk" />
    <file src="build\*.*" target="build" />
    <file src="build\fallback\*" target="build\fallback" />
  </files>
</package>
